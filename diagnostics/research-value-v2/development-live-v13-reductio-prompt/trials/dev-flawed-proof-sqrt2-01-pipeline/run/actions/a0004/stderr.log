atement":"An integer n is even exactly when n=2k for some integer k.","step_ids":[],"tool_ids":[]},{"basis":"derivation","basis_reference":"Proved in step-parity-square.","citations":[],"critical":true,"depends_on":["even-definition"],"discharged_by_step_ids":[],"id":"parity-square","kind":"deduction","scope_step_ids":[],"statement":"For every integer n, if n squared is even, then n is even.","step_ids":["step-parity-square"],"tool_ids":[]},{"basis":"local_assumption","basis_reference":"Temporary negation of the desired irrationality conclusion for reductio.","citations":[],"critical":true,"depends_on":[],"discharged_by_step_ids":["step-common-factor"],"id":"lowest-terms-assumption","kind":"assumption","scope_step_ids":["step-square","step-a-square-even","step-a-even","step-substitute","step-b-square-even","step-b-even","step-common-factor"],"statement":"Assume that there are integers a and b with b nonzero and gcd(a,b)=1 such that sqrt(2)=a/b.","step_ids":["step-assume"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Derived from the assumed representation and the defining equation (sqrt(2)) squared=2.","citations":[],"critical":true,"depends_on":["lowest-terms-assumption"],"discharged_by_step_ids":[],"id":"squared-equation","kind":"deduction","scope_step_ids":[],"statement":"Under the temporary assumption, a squared equals 2b squared.","step_ids":["step-square"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Derived using the parity-square lemma in steps step-a-even and step-b-even.","citations":[],"critical":true,"depends_on":["squared-equation","parity-square"],"discharged_by_step_ids":[],"id":"both-even","kind":"deduction","scope_step_ids":[],"statement":"Under the temporary assumption, both a and b are even.","step_ids":["step-a-even","step-b-even"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Derived in step-common-factor from both-evenness and gcd(a,b)=1.","citations":[],"critical":true,"depends_on":["both-even","lowest-terms-assumption"],"discharged_by_step_ids":[],"id":"lowest-terms-contradiction","kind":"deduction","scope_step_ids":[],"statement":"The temporary lowest-terms representation yields a contradiction.","step_ids":["step-common-factor"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Reductio completed in step-irrational by the contradiction that discharges the temporary assumption.","citations":[],"critical":true,"depends_on":["lowest-terms-assumption","lowest-terms-contradiction"],"discharged_by_step_ids":[],"id":"sqrt-two-irrational","kind":"deduction","scope_step_ids":[],"statement":"There is no lowest-terms integer fraction equal to sqrt(2); hence sqrt(2) is irrational.","step_ids":["step-common-factor","step-irrational"],"tool_ids":[]}],"open_questions":[],"proof_steps":[{"citations":[],"depends_on":[],"id":"step-assume","justification":"This is the temporary assumption for proof by contradiction.","statement":"Assume sqrt(2)=a/b for integers a,b with b nonzero and gcd(a,b)=1."},{"citations":[],"depends_on":["step-assume"],"id":"step-square","justification":"Squaring sqrt(2)=a/b gives 2=a squared/b squared; multiplying by b squared gives the result.","statement":"Derive a squared=2b squared."},{"citations":[],"depends_on":[],"id":"step-parity-square","justification":"If an integer n is not even, write n=2k+1. Then n squared=4k squared+4k+1=2(2k squared+2k)+1, which is not even. Therefore, contrapositively, an even square has an even base.","statement":"Establish that if an integer square is even, then the integer is even."},{"citations":[],"depends_on":["step-square"],"id":"step-a-square-even","justification":"The right-hand side 2b squared is divisible by 2.","statement":"Infer that a squared is even."},{"citations":[],"depends_on":["step-a-square-even","step-parity-square"],"id":"step-a-even","justification":"Apply the parity-square result to a.","statement":"Infer that a is even."},{"citations":[],"depends_on":["step-square","step-a-even"],"id":"step-substitute","justification":"Since a is even, write a=2c. Substitution gives 4c squared=2b squared, and division by 2 gives b squared=2c squared.","statement":"Derive b squared=2c squared for an integer c."},{"citations":[],"depends_on":["step-substitute"],"id":"step-b-square-even","justification":"The equation b squared=2c squared shows b squared is divisible by 2.","statement":"Infer that b squared is even."},{"citations":[],"depends_on":["step-b-square-even","step-parity-square"],"id":"step-b-even","justification":"Apply the parity-square result to b.","statement":"Infer that b is even."},{"citations":[],"depends_on":["step-a-even","step-b-even","step-assume"],"id":"step-common-factor","justification":"If a=2c and b=2d, then 2 is a common divisor of a and b, contradicting gcd(a,b)=1. This discharges the temporary assumption.","statement":"Obtain a contradiction with the lowest-terms condition."},{"citations":[],"depends_on":["step-common-factor"],"id":"step-irrational","justification":"Because the assumed rational representation leads to contradiction, no such representation exists.","statement":"Conclude that sqrt(2) is irrational."}],"question_status":"answered","tool_requests":[]}}},"objective":"prove","output_schema":{"additionalProperties":false,"properties":{"answer":{"maxLength":12000,"type":"string"},"approaches":{"items":{"additionalProperties":false,"properties":{"description":{"maxLength":4000,"type":"string"},"id":{"maxLength":64,"pattern":"[a-z][a-z0-9-]{2,63}","type":"string"},"outcome":{"enum":["candidate","rejected","incomplete"],"type":"string"},"reason":{"maxLength":4000,"type":"string"}},"required":["id","description","outcome","reason"],"type":"object"},"maxItems":3,"type":"array"},"change_log":{"items":{"maxLength":4000,"type":"string"},"maxItems":8,"type":"array"},"claims":{"items":{"additionalProperties":false,"properties":{"basis":{"enum":["question_premise","additional_assumption","local_assumption","standard_result","external_fact","derivation","c