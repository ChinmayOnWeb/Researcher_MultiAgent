tor.","citations":[],"critical":true,"depends_on":[],"discharged_by_step_ids":[],"id":"numerator-factorization","kind":"deduction","scope_step_ids":[],"statement":"For every real x, x^2-4=(x-2)(x+2).","step_ids":["factor-numerator"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Derived in cancel-on-domain.","citations":[],"critical":true,"depends_on":["original-domain","numerator-factorization"],"discharged_by_step_ids":[],"id":"conditional-simplification","kind":"deduction","scope_step_ids":[],"statement":"For every real x≠2, R(x)=x+2.","step_ids":["cancel-on-domain"],"tool_ids":[]},{"basis":"derivation","basis_reference":"Derived in compare-excluded-input.","citations":[],"critical":true,"depends_on":["original-domain","conditional-simplification"],"discharged_by_step_ids":[],"id":"domain-comparison","kind":"deduction","scope_step_ids":[],"statement":"R and x+2 agree on the domain of R, but are not equal as functions defined at every real number: R is undefined at 2 while x+2=4.","step_ids":["compare-excluded-input"],"tool_ids":[]}],"open_questions":[],"proof_steps":[{"citations":[],"depends_on":[],"id":"denominator-zero","justification":"Solving x-2=0 gives x=2; conversely, substituting x=2 gives denominator 0.","statement":"The denominator x-2 is zero exactly when x=2."},{"citations":[],"depends_on":["denominator-zero"],"id":"establish-domain","justification":"A quotient of real numbers is defined only when its denominator is nonzero.","statement":"R is defined exactly when x≠2."},{"citations":[],"depends_on":[],"id":"factor-numerator","justification":"Expanding gives (x-2)(x+2)=x²+2x-2x-4=x²-4.","statement":"x²-4=(x-2)(x+2) for every real x."},{"citations":[],"depends_on":["establish-domain","factor-numerator"],"id":"cancel-on-domain","justification":"For x≠2, the factor x-2 is nonzero, so ((x-2)(x+2))/(x-2)=x+2.","statement":"For every x in the domain of R, R(x)=x+2."},{"citations":[],"depends_on":["establish-domain","cancel-on-domain"],"id":"compare